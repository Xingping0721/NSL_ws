declare tut2 simulation { }
module tut2 {
    reg count[5]=0;
    wire x[5],y[5];
    any {
        count < 10 : {
            _display("x=%d,y=%d,count=%d",x,y,count);
            count := x; // count is a reg so it will be change next cycle
            y = x + 1;  // x, y are wires so they can be assigned immediately
            x = count + 1; // x as well
        }
        count >= 10:
        _finish("End");
    }
}