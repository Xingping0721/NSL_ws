declare tut7 simulation {}

declare fadd4 {
    input a[4];
    input b[4];
    input ci;
    output q[4];
    output c;
    output o;
    func_in ex(a,b,ci) : q;
}

struct byte_nibble {
    hi[4];
    lo[4];
} ;

module tut7 {
    byte_nibble reg count = 0 ; //initialization, structure
    fadd4 sm[2];                //declare, it means two fadd4 module, and the name is sm[0] and sm[1] 
    count++;
    if(count>60) {
        byte_nibble wire res;   // structure, wire, and the name is res
        res.lo=sm[0].ex(count.lo,count.lo,0);   
        res.hi=sm[1].ex(count.hi,count.hi,sm[0].c);
        _display("count:%d, res:%d, ovf:%d", count, res, sm[1].o);
    }
    if(count==70) _finish("bye");
}
module fadd4 {
    func ex {       // input is a, b, ci, and output is q
        wire qs[4],qe[2];
        qs = {0b0,3'(a)} + {0b0,3'(b)} + 4'(ci);    // in this statement, a and b are transfor to 4bit, and replace the first bit with 0, and add them together
        qe = (2'(a[3])+2'(b[3])+2'(qs[3]));         // a[3]、b[3]、qs[3] はそれぞれの最上位ビットです。これを2ビットに拡張して足すことで, qe[1] = 桁上がり出力(carry out), qe[0] = 最上位ビットの加算結果
        c = qe[1];                                  // qe[1] represents the carry out
        o = qe[1] ^ qs[3];                          // overflow or not
        return {qe[0],3'(qs)};
    }
}