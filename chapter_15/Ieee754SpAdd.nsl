///////////////////////// below is the test bench for simulation /////////////////////////
// i will calclate 30.0 + 8000.0 for test.


/*
    シミュレーション用のトップモジュール（テストベンチ）
    これが「外の世界（親回路）」として振る舞います。
*/
declare sim { }

module sim {
    // さっきの足し算回路を「adder」という名前で部品として用意する
    Ieee754SpAdd adder;
    
    // 時間を測るための簡単なカウンター
    reg count[4] = 0;

    // シミュレーション開始（countが0の時、1回だけ実行）
    if (count == 0) {
        // 30.0 (0x41F00000) と 8000.0 (0x45FA0000) を入力して計算スタート！
        adder.exe(32'h41F00000, 32'h45FA0000);
        _display("--- Simulation Start ---");
        _display("Calculate: 30.0 + 8000.0");
    }

    // 先ほど話題になった「done」ランプが光るのを待ち構える！
    if (adder.done) {
        // doneが来たら、結果(adder.result)を画面に表示して終了する
        _display("Done! Result: %x (Expected: 45faf000 = 8030.0)", adder.result);
        _finish(); // シミュレーションを終了する命令
    }

    // 毎クロック、カウンターを増やしていく
    count++;
}